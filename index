<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#0a0a0c">
    <title>Build your AI</title>
    <style>
        :root {
            --bg-color: #0a0a0c;
            --panel-bg: #141419;
            --primary-blue: #007bff;
            --hover-blue: #0056b3;
            --text-white: #ffffff;
            --error-red: #ff3b3b;
            --success-green: #00ff88;
            --border-color: #2a2a35;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Roboto, sans-serif; }
        body {
            background-color: var(--bg-color);
            color: var(--text-white);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 15px;
        }
        .screen {
            display: none;
            flex-direction: column;
            width: 100%;
            max-width: 400px;
            background: var(--panel-bg);
            padding: 30px 20px;
            border-radius: 16px;
            border: 1px solid var(--border-color);
            box-shadow: 0 0 30px rgba(0, 123, 255, 0.1);
        }
        .screen.active { display: flex; }
        h1, h2 { text-align: center; margin-bottom: 25px; font-weight: 600; letter-spacing: 1px; }
        h1 span { color: var(--primary-blue); }
        input {
            background: var(--bg-color);
            border: 1px solid var(--border-color);
            color: var(--text-white);
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 15px;
            font-size: 16px;
            outline: none;
            transition: border 0.3s;
        }
        input:focus { border-color: var(--primary-blue); }
        button {
            background-color: var(--primary-blue);
            color: var(--text-white);
            border: none;
            padding: 16px;
            border-radius: 8px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            margin-bottom: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.2s;
        }
        button:active { background-color: var(--hover-blue); transform: scale(0.98); }
        button:disabled { opacity: 0.6; cursor: not-allowed; }
        button.disabled-btn {
            background-color: #2a2a35;
            color: #666;
            border: 1px dashed #444;
        }
        .error-msg {
            color: var(--error-red);
            font-size: 13px;
            margin-bottom: 15px;
            text-align: center;
            min-height: 20px;
            font-weight: 500;
        }
        .success-msg {
            color: var(--success-green);
            font-size: 13px;
            margin-bottom: 15px;
            text-align: center;
            min-height: 20px;
        }
        .welcome-text {
            text-align: center;
            color: #888;
            margin-bottom: 30px;
            font-size: 14px;
        }
        .back-btn {
            background: transparent !important;
            border: 1px solid var(--border-color) !important;
            color: #aaa !important;
            text-transform: none !important;
            letter-spacing: normal !important;
        }
        .loading { opacity: 0.5; pointer-events: none; }
        .status-indicator {
            position: absolute;
            top: 10px;
            right: 15px;
            font-size: 11px;
            color: #555;
        }
        .status-indicator.online { color: var(--success-green); }
    </style>
</head>
<body>

    <!-- ЭКРАН 1: РЕГИСТРАЦИЯ -->
    <div id="screen-register" class="screen active">
        <h1>BUILD YOUR <span>AI</span></h1>
        <p style="text-align:center; color:#666; margin-bottom:20px; font-size:13px;">
            Создай свою компанию и начни строить ИИ
        </p>
        <input type="text" id="reg-company" placeholder="Название компании (Eng)" maxlength="10" autocomplete="off">
        <div id="reg-error" class="error-msg"></div>
        <div id="reg-success" class="success-msg"></div>
        <button id="btn-register" onclick="register()">Создать компанию</button>
    </div>

    <!-- ЭКРАН 2: ГЛАВНОЕ МЕНЮ -->
    <div id="screen-menu" class="screen">
        <div class="status-indicator online">● ONLINE</div>
        <h2>Главное меню</h2>
        <p class="welcome-text">
            Компания: <span id="display-company" style="color: var(--primary-blue); font-weight:bold;"></span>
        </p>
        
        <button class="disabled-btn" disabled>⚔️ Арена (В разработке!)</button>
        <button class="disabled-btn" disabled>⚡ Прокачка (В разработке!)</button>
        <button class="disabled-btn" disabled>🏆 Рейтинг (В разработке!)</button>
        
        <button onclick="showScreen('screen-create-ai')">🤖 Создать ИИ</button>
        <button class="back-btn" onclick="logout()" style="margin-top:20px;">Выйти</button>
    </div>

    <!-- ЭКРАН 3: СОЗДАНИЕ ИИ -->
    <div id="screen-create-ai" class="screen">
        <h2>Создание ИИ</h2>
        <p style="text-align:center; color:#666; margin-bottom:20px; font-size:13px;">
            Дай имя своему ИИ-агенту
        </p>
        <input type="text" id="ai-name" placeholder="Имя ИИ (Eng, без пробелов)" maxlength="10" autocomplete="off">
        <div id="ai-error" class="error-msg"></div>
        <div id="ai-success" class="success-msg"></div>
        <button id="btn-create-ai" onclick="createAI()">Инициализировать</button>
        <button class="back-btn" onclick="showScreen('screen-menu')">Назад в меню</button>
    </div>

    <!-- Supabase SDK -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script>
        // ========================================
        // КОНФИГУРАЦИЯ SUPABASE
        // ========================================
        const SUPABASE_URL = 'https://troolvyvzmqwymynmlsk.supabase.co';
        const SUPABASE_KEY = 'sb_publishable_qExqBRScZNQNYUgkZn6-kQ_NI-RqKCy';
        const supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

        // ========================================
        // ФИЛЬТР МАТОВ И ЗАПРЕЩЁННЫХ СЛОВ
        // ========================================
        const bannedWords = [
            'fuck', 'shit', 'bitch', 'asshole', 'dick', 'pussy', 'cock', 'cunt',
            'whore', 'slut', 'porn', 'sex', 'nigga', 'nigger', 'faggot', 'retard',
            'nazi', 'hitler', 'kys'
        ];

        // ========================================
        // ФУНКЦИИ ВАЛИДАЦИИ
        // ========================================
        function isEnglishLettersOnly(text) { return /^[a-zA-Z]+$/.test(text); }
        function hasRepeatingLetters(text) { return /(.)\1{2,}/.test(text.toLowerCase()); }
        function isValidLength(text) { return text.length >= 2 && text.length <= 10; }
        function containsBannedWord(text) {
            const lower = text.toLowerCase();
            return bannedWords.some(w => lower.includes(w));
        }

        function validateName(text, errorEl, type = 'generic') {
            if (!isValidLength(text)) { 
                errorEl.textContent = `Ошибка: от 2 до 10 символов.`; 
                return false; 
            }
            if (!isEnglishLettersOnly(text)) { 
                errorEl.textContent = `Ошибка: только англ. буквы, без пробелов.`; 
                return false; 
            }
            if (hasRepeatingLetters(text)) { 
                errorEl.textContent = `Ошибка: запрещено 3+ одинаковых букв подряд.`; 
                return false; 
            }
            if (containsBannedWord(text)) { 
                errorEl.textContent = `⚠️ ОШИБКА: недопустимое название.`; 
                return false; 
            }
            return true;
        }

        // ========================================
        // UI ФУНКЦИИ
        // ========================================
        function showScreen(id) {
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            document.getElementById(id).classList.add('active');
            document.querySelectorAll('.error-msg, .success-msg').forEach(e => e.textContent = '');
        }

        function setLoading(buttonId, isLoading) {
            const btn = document.getElementById(buttonId);
            if (!btn) return;
            if (isLoading) {
                btn.dataset.originalText = btn.textContent;
                btn.textContent = 'Загрузка...';
                btn.disabled = true;
            } else {
                btn.textContent = btn.dataset.originalText || btn.textContent;
                btn.disabled = false;
            }
        }

        function logout() {
            if (confirm('Выйти из аккаунта? Данные останутся в базе.')) {
                localStorage.clear();
                document.getElementById('reg-company').value = '';
                showScreen('screen-register');
            }
        }

        // ========================================
        // ПОЛУЧЕНИЕ IP
        // ========================================
        async function getClientIP() {
            try {
                const r = await fetch('https://api.ipify.org?format=json');
                return (await r.json()).ip;
            } catch (e) { 
                console.warn('Не удалось получить IP:', e);
                return "unknown"; 
            }
        }

        // ========================================
        // РЕГИСТРАЦИЯ КОМПАНИИ
        // ========================================
        async function register() {
            const name = document.getElementById('reg-company').value.trim();
            const err = document.getElementById('reg-error');
            const success = document.getElementById('reg-success');
            err.textContent = '';
            success.textContent = '';

            if (!validateName(name, err, 'company')) return;

            setLoading('btn-register', true);
            const ip = await getClientIP();

            try {
                // 1. Проверяем IP
                const { data: ipExists } = await supabaseClient
                    .from('companies')
                    .select('id')
                    .eq('ip', ip)
                    .limit(1);

                if (ipExists && ipExists.length > 0) {
                    err.textContent = "С этого IP уже создана компания!";
                    setLoading('btn-register', false);
                    return;
                }

                // 2. Проверяем имя (на случай если UNIQUE constraint не сработал)
                const { data: nameExists } = await supabaseClient
                    .from('companies')
                    .select('id')
                    .eq('name', name)
                    .limit(1);

                if (nameExists && nameExists.length > 0) {
                    err.textContent = "Компания с таким именем уже существует!";
                    setLoading('btn-register', false);
                    return;
                }

                // 3. Сохраняем в базу
                const { data, error } = await supabaseClient
                    .from('companies')
                    .insert([{ name: name, ip: ip }])
                    .select();

                if (error) {
                    if (error.code === '23505') {
                        err.textContent = "Такое имя уже занято!";
                    } else {
                        err.textContent = "Ошибка сервера: " + error.message;
                        console.error(error);
                    }
                    setLoading('btn-register', false);
                    return;
                }

                // 4. Сохраняем локально
                localStorage.setItem('byai_company', name);
                localStorage.setItem('byai_company_id', data[0].id);
                localStorage.setItem('byai_registered', 'true');

                success.textContent = "✓ Компания создана!";
                setTimeout(() => {
                    document.getElementById('display-company').textContent = name;
                    showScreen('screen-menu');
                }, 800);

            } catch (e) {
                err.textContent = "Ошибка сети. Проверь интернет.";
                console.error(e);
            } finally {
                setLoading('btn-register', false);
            }
        }

        // ========================================
        // СОЗДАНИЕ ИИ
        // ========================================
        async function createAI() {
            const name = document.getElementById('ai-name').value.trim();
            const err = document.getElementById('ai-error');
            const success = document.getElementById('ai-success');
            err.textContent = '';
            success.textContent = '';

            if (!validateName(name, err, 'ai')) return;

            setLoading('btn-create-ai', true);
            const companyId = localStorage.getItem('byai_company_id');

            try {
                // Проверяем, есть ли уже такое имя у этой компании
                const { data: exists } = await supabaseClient
                    .from('ais')
                    .select('id')
                    .eq('company_id', companyId)
                    .eq('name', name)
                    .limit(1);

                if (exists && exists.length > 0) {
                    err.textContent = "У тебя уже есть ИИ с таким именем!";
                    setLoading('btn-create-ai', false);
                    return;
                }

                // Сохраняем ИИ
                const { data, error } = await supabaseClient
                    .from('ais')
                    .insert([{ name: name, company_id: companyId }])
                    .select();

                if (error) {
                    err.textContent = "Ошибка: " + error.message;
                    console.error(error);
                    setLoading('btn-create-ai', false);
                    return;
                }

                success.textContent = `✓ ИИ "${name}" инициализирован!`;
                document.getElementById('ai-name').value = '';
                setTimeout(() => showScreen('screen-menu'), 1200);

            } catch (e) {
                err.textContent = "Ошибка сети.";
                console.error(e);
            } finally {
                setLoading('btn-create-ai', false);
            }
        }

        // ========================================
        // АВТОЗАГРУЗКА
        // ========================================
        window.onload = () => {
            if (localStorage.getItem('byai_registered') === 'true') {
                document.getElementById('display-company').textContent = 
                    localStorage.getItem('byai_company');
                showScreen('screen-menu');
            }
        };

        // Enter для отправки форм
        document.getElementById('reg-company').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') register();
        });
        document.getElementById('ai-name').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') createAI();
        });
    </script>
</body>
</html>
